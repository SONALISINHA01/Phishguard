# PhishGuard Environment Configuration
# Optional: Add your Google Gemini API key from https://aistudio.google.com/
# If left empty, PhishGuard automatically runs using its local heuristic engine.
GEMINI_API_KEY=your_gemini_api_key_here

# PhishTank dataset file path (defaults to local data/phishtank/verified_online.csv)
PHISHTANK_DATA_PATH=data/phishtank/verified_online.csv

# Decision thresholds (0 to 100)
SAFE_THRESHOLD=30
QUARANTINE_THRESHOLD=75
